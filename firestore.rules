rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Identity & Validation Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailKey(email) {
      return email is string && email.size() >= 3 && email.size() <= 120 && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidPhoneKey(phone) {
      return phone is string && phone.size() >= 8 && phone.size() <= 20 && phone.matches('^[0-9]{8,15}$');
    }

    function isValidPin(pin) {
      return pin is string && pin.size() == 4 && pin.matches('^[0-9]{4}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // PIN-verified Staff & Admin Sessions (supports silent signInAnonymously without Google popups)
    function hasStaffSession() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff_sessions/$(request.auth.uid));
    }

    function staffSessionData() {
      return get(/databases/$(database)/documents/staff_sessions/$(request.auth.uid)).data;
    }

    function isValidAdminPin(pin) {
      return isValidPin(pin) && (
        (!exists(/databases/$(database)/documents/config/staff) && pin == '0000') ||
        (exists(/databases/$(database)/documents/config/staff) &&
          get(/databases/$(database)/documents/config/staff).data.adminPin == pin)
      );
    }

    function isAdmin() {
      return hasStaffSession() &&
        staffSessionData().isAdmin == true &&
        isValidAdminPin(staffSessionData().pin);
    }

    function isActiveEmployeeSession() {
      return hasStaffSession() &&
        staffSessionData().isAdmin == false &&
        exists(/databases/$(database)/documents/staff/$(staffSessionData().staffId)) &&
        get(/databases/$(database)/documents/staff/$(staffSessionData().staffId)).data.active == true &&
        get(/databases/$(database)/documents/staff/$(staffSessionData().staffId)).data.pin == staffSessionData().pin;
    }

    function isStaff() {
      return isAdmin() || isActiveEmployeeSession();
    }

    function hasPerm(permKey) {
      return isAdmin() || (
        isActiveEmployeeSession() &&
        get(/databases/$(database)/documents/staff/$(staffSessionData().staffId)).data.permissions[permKey] == true
      );
    }

    // Validation Blueprint: MenuItemDoc
    function isValidMenuItem(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'description', 'priceBadge',
          'sizes', 'ingredients', 'rating', 'prepTime', 'available',
          'visualType', 'sortOrder', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'description', 'priceBadge',
          'sizes', 'ingredients', 'rating', 'prepTime', 'available',
          'visualType', 'sortOrder', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.category in ['Platos Fuertes', 'Guisos', 'Sopas', 'Jugos'] &&
        data.description is string && data.description.size() <= 300 &&
        data.priceBadge is string && data.priceBadge.size() >= 1 && data.priceBadge.size() <= 120 &&
        data.sizes is list && data.sizes.size() >= 1 && data.sizes.size() <= 3 &&
        data.sizes[0] is map &&
        data.ingredients is list && data.ingredients.size() <= 12 &&
        (data.ingredients.size() == 0 || data.ingredients[0] is string) &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.prepTime is string && data.prepTime.size() <= 40 &&
        data.available is bool &&
        data.visualType is string && data.visualType.size() <= 40 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 500 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: TableDoc
    function isValidTable(data) {
      return data.keys().hasAll(['number', 'status', 'capacity', 'updatedAt']) &&
        data.keys().hasOnly(['number', 'name', 'zone', 'status', 'capacity', 'updatedAt']) &&
        data.number is number && data.number >= 1 && data.number <= 99 &&
        (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 80)) &&
        (!('zone' in data) || (data.zone is string && data.zone.size() >= 1 && data.zone.size() <= 40)) &&
        data.status in ['libre', 'ocupada'] &&
        data.capacity is number && data.capacity >= 1 && data.capacity <= 30 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: OrderDoc (NO PII)
    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'code', 'customerUid', 'mode', 'customerLabel',
          'items', 'notes', 'status', 'total', 'estimatedMinutes',
          'createdAtLabel', 'paid', 'waiterRequested', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'customerUid', 'mode', 'tableNumber', 'customerLabel',
          'pickupNote', 'confirmationCode', 'items', 'notes', 'status', 'total', 'estimatedMinutes',
          'createdAtLabel', 'deliveredAtLabel', 'paid', 'paymentMethod',
          'waiterRequested', 'billRequested', 'ratingStars', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 20 &&
        data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
        data.mode in ['dine-in', 'takeaway', 'delivery'] &&
        (!('tableNumber' in data) || (data.tableNumber is number && data.tableNumber >= 1 && data.tableNumber <= 99)) &&
        data.customerLabel is string && data.customerLabel.size() >= 1 && data.customerLabel.size() <= 80 &&
        (!('pickupNote' in data) || (data.pickupNote is string && data.pickupNote.size() <= 120)) &&
        (!('confirmationCode' in data) || (data.confirmationCode is string && data.confirmationCode.size() == 4 && data.confirmationCode.matches('^[0-9]{4}$'))) &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
        data.items[0] is map &&
        data.notes is string && data.notes.size() <= 300 &&
        data.status in ['Preparando', 'Listo', 'En camino', 'Entregado', 'Cobrado'] &&
        data.total is number && data.total > 0 && data.total <= 50000 &&
        data.estimatedMinutes is number && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 180 &&
        data.createdAtLabel is string && data.createdAtLabel.size() >= 1 && data.createdAtLabel.size() <= 20 &&
        (!('deliveredAtLabel' in data) || (data.deliveredAtLabel is string && data.deliveredAtLabel.size() <= 20)) &&
        data.paid is bool &&
        (!('paymentMethod' in data) || data.paymentMethod in ['Efectivo', 'QR', 'Transferencia Bancaria', 'Tarjeta']) &&
        data.waiterRequested is bool &&
        (!('billRequested' in data) || data.billRequested is bool) &&
        (!('ratingStars' in data) || (data.ratingStars is number && data.ratingStars >= 1 && data.ratingStars <= 5)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: OrderPrivateDeliveryDoc (Isolated PII)
    function isValidPrivateDelivery(data) {
      return data.keys().hasAll(['customerUid', 'address', 'phone', 'updatedAt']) &&
        data.keys().hasOnly(['customerUid', 'address', 'reference', 'phone', 'updatedAt']) &&
        data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
        data.address is string && data.address.size() >= 1 && data.address.size() <= 220 &&
        (!('reference' in data) || (data.reference is string && data.reference.size() <= 220)) &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: OrderPrivateContactDoc (Isolated WhatsApp PII)
    function isValidPrivateContact(data) {
      return data.keys().hasAll(['customerUid', 'phone', 'updatedAt']) &&
        data.keys().hasOnly(['customerUid', 'phone', 'tableNumber', 'updatedAt']) &&
        data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
        isValidPhoneKey(data.phone) &&
        (!('tableNumber' in data) || (data.tableNumber is number && data.tableNumber >= 1 && data.tableNumber <= 99)) &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: TableSessionDoc (Isolated Table Phone PII)
    function isValidTableSession(data) {
      return data.keys().hasAll(['tableNumber', 'customerUid', 'customerPhone', 'updatedAt']) &&
        data.keys().hasOnly(['tableNumber', 'customerUid', 'customerPhone', 'activeOrderId', 'updatedAt']) &&
        data.tableNumber is number && data.tableNumber >= 1 && data.tableNumber <= 99 &&
        data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
        isValidPhoneKey(data.customerPhone) &&
        (!('activeOrderId' in data) || isValidId(data.activeOrderId)) &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: CustomerContactDoc (CRM / Digital Receipt Directory)
    function isValidCustomerContact(data) {
      return data.keys().hasAll([
          'phone', 'customerUid', 'lastMode', 'lastOrderTotal',
          'ordersCount', 'source', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'phone', 'customerUid', 'lastTableNumber', 'lastMode', 'lastOrderCode',
          'lastOrderTotal', 'ordersCount', 'source', 'createdAt', 'updatedAt'
        ]) &&
        isValidPhoneKey(data.phone) &&
        data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128 &&
        (!('lastTableNumber' in data) || (data.lastTableNumber is number && data.lastTableNumber >= 1 && data.lastTableNumber <= 99)) &&
        data.lastMode in ['dine-in', 'takeaway', 'delivery'] &&
        (!('lastOrderCode' in data) || (data.lastOrderCode is string && data.lastOrderCode.size() <= 20)) &&
        data.lastOrderTotal is number && data.lastOrderTotal >= 0 && data.lastOrderTotal <= 500000 &&
        data.ordersCount is number && data.ordersCount >= 0 && data.ordersCount <= 10000 &&
        data.source in ['qr-table', 'delivery', 'takeaway', 'pos'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: InventoryItemDoc
    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'name', 'quantity', 'unit', 'status', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'quantity', 'unit', 'status', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.quantity is number && data.quantity >= 0 && data.quantity <= 100000 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
        data.status in ['Stock OK', 'Bajo stock'] &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: StaffConfigDoc
    function isValidStaffConfig(data) {
      return data.keys().hasAll(['adminPin', 'mozoPin', 'updatedAt']) &&
        data.keys().hasOnly(['adminPin', 'mozoPin', 'updatedAt']) &&
        isValidPin(data.adminPin) &&
        isValidPin(data.mozoPin) &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: StaffMemberDoc
    function isValidStaffPermissions(perms) {
      return perms is map &&
        perms.keys().hasAll(['orders_tables', 'kitchen_board', 'cashier_billing', 'menu_pricing', 'reports_history']) &&
        perms.keys().hasOnly(['orders_tables', 'kitchen_board', 'cashier_billing', 'menu_pricing', 'reports_history']) &&
        perms.orders_tables is bool &&
        perms.kitchen_board is bool &&
        perms.cashier_billing is bool &&
        perms.menu_pricing is bool &&
        perms.reports_history is bool;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'pin', 'active', 'permissions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'role', 'pin', 'active', 'permissions', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.role in ['Mozo', 'Cajero', 'Cocina'] &&
        isValidPin(data.pin) &&
        data.active is bool &&
        isValidStaffPermissions(data.permissions) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: StaffSessionDoc
    function isValidStaffSession(data) {
      return data.keys().hasAll(['uid', 'staffId', 'name', 'role', 'pin', 'isAdmin', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'staffId', 'name', 'role', 'pin', 'isAdmin', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        isValidId(data.staffId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.role in ['Admin', 'Mozo', 'Cajero', 'Cocina'] &&
        isValidPin(data.pin) &&
        data.isAdmin is bool &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Validation Blueprint: Legacy AuthorizedStaffDoc
    function isValidAuthorizedStaff(data) {
      return data.keys().hasAll(['email', 'name', 'active', 'createdAt']) &&
        data.keys().hasOnly(['email', 'name', 'active', 'createdAt']) &&
        isValidEmailKey(data.email) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.active is bool &&
        data.createdAt is timestamp;
    }

    // 1. Menu Catalog (non-PII, public readable, admin or menu_pricing staff writable)
    match /menuItems/{dishId} {
      allow get: if isValidId(dishId);
      allow list: if true;
      allow create: if isValidId(dishId) && hasPerm('menu_pricing') && isValidMenuItem(incoming()) && incoming().id == dishId;
      allow update: if isValidId(dishId) && hasPerm('menu_pricing') && isValidMenuItem(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(dishId) && isAdmin();
    }

    // 2. Tables (non-PII, public readable, staff create/update/delete-when-libre + signed-in customer occupy-on-order)
    match /tables/{tableId} {
      allow get: if isValidId(tableId);
      allow list: if true;
      allow create: if isValidId(tableId) && (hasPerm('orders_tables') || hasPerm('cashier_billing')) && isValidTable(incoming());
      allow update: if isValidId(tableId) && isValidTable(incoming()) && (
        hasPerm('orders_tables') ||
        hasPerm('cashier_billing') ||
        (
          isSignedIn() &&
          existing().status == 'libre' &&
          incoming().status == 'ocupada' &&
          incoming().number == existing().number &&
          incoming().capacity == existing().capacity &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
      );
      allow delete: if isValidId(tableId) && (hasPerm('orders_tables') || hasPerm('cashier_billing')) && existing().status == 'libre';
    }

    // 3. Orders (customer sees own orders; active staff sees all orders)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isStaff() ||
        (isSignedIn() && existing().customerUid == request.auth.uid)
      );
      allow list: if isStaff() || (
        isSignedIn() && existing().customerUid == request.auth.uid
      );
      allow create: if isValidId(orderId) &&
        isSignedIn() &&
        isValidOrder(incoming()) &&
        incoming().id == orderId &&
        incoming().createdAt == request.time &&
        (!(incoming().mode in ['takeaway', 'delivery']) || ('confirmationCode' in incoming())) &&
        (
          hasPerm('orders_tables') ||
          hasPerm('cashier_billing') ||
          (
            incoming().customerUid == request.auth.uid &&
            incoming().status == 'Preparando' &&
            (
              incoming().paid == false ||
              (incoming().mode == 'delivery' && incoming().paid == true && 'paymentMethod' in incoming())
            )
          )
        );
      allow update: if isValidId(orderId) &&
        isSignedIn() &&
        isValidOrder(incoming()) &&
        incoming().id == existing().id &&
        incoming().customerUid == existing().customerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().mode == existing().mode &&
        (!('confirmationCode' in existing()) || ('confirmationCode' in incoming() && incoming().confirmationCode == existing().confirmationCode)) &&
        (
          isAdmin() ||
          (
            isStaff() &&
            existing().status != 'Cobrado' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'items', 'total', 'notes', 'pickupNote', 'status', 'deliveredAtLabel',
              'paid', 'paymentMethod', 'waiterRequested', 'billRequested', 'tableNumber', 'customerLabel', 'updatedAt'
            ]) &&
            (
              !incoming().diff(existing()).affectedKeys().hasAny(['paid', 'paymentMethod']) ||
              hasPerm('cashier_billing')
            ) &&
            (
              !incoming().diff(existing()).affectedKeys().hasAny(['tableNumber', 'customerLabel']) ||
              (existing().mode == 'dine-in' && ('tableNumber' in incoming()) && incoming().tableNumber is number)
            )
          ) ||
          (
            existing().customerUid == request.auth.uid &&
            (
              (
                !(existing().status == 'Entregado' && existing().paid == true) &&
                (
                  (
                    existing().paid == false &&
                    incoming().paid == false &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['items', 'total', 'status', 'updatedAt'])
                  ) ||
                  (
                    incoming().waiterRequested == true &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['waiterRequested', 'billRequested', 'updatedAt'])
                  ) ||
                  (
                    existing().mode == 'delivery' &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveredAtLabel', 'ratingStars', 'updatedAt'])
                  ) ||
                  (
                    existing().paid == false &&
                    incoming().paid == true &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['paid', 'paymentMethod', 'updatedAt'])
                  )
                )
              ) ||
              (
                existing().mode == 'delivery' &&
                !('ratingStars' in existing()) &&
                incoming().diff(existing()).affectedKeys().hasOnly(['ratingStars', 'updatedAt'])
              )
            )
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();

      // 3B. Isolated Private Delivery PII
      match /private/delivery {
        allow get: if isValidId(orderId) && (
          isStaff() ||
          (
            isSignedIn() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
          )
        );
        allow create: if isValidId(orderId) &&
          isSignedIn() &&
          isValidPrivateDelivery(incoming()) &&
          (isStaff() || incoming().customerUid == request.auth.uid) &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == incoming().customerUid;
        allow update: if isValidId(orderId) &&
          isSignedIn() &&
          isValidPrivateDelivery(incoming()) &&
          incoming().customerUid == existing().customerUid &&
          isStaff();
        allow delete: if isValidId(orderId) && isAdmin();
      }

      // 3C. Isolated Private WhatsApp Contact PII
      match /private/contact {
        allow get: if isValidId(orderId) && (
          isStaff() ||
          (
            isSignedIn() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid
          )
        );
        allow create: if isValidId(orderId) &&
          isSignedIn() &&
          isValidPrivateContact(incoming()) &&
          (isStaff() || incoming().customerUid == request.auth.uid) &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == incoming().customerUid;
        allow update: if isValidId(orderId) &&
          isSignedIn() &&
          isValidPrivateContact(incoming()) &&
          incoming().customerUid == existing().customerUid &&
          (isStaff() || incoming().customerUid == request.auth.uid);
        allow delete: if isValidId(orderId) && isAdmin();
      }
    }

    // 3D. Isolated Table Sessions (WhatsApp phone attached to active table, Staff or Owner only)
    match /table_sessions/{tableId} {
      allow get: if isValidId(tableId) && (
        isStaff() ||
        (isSignedIn() && existing().customerUid == request.auth.uid)
      );
      allow list: if isStaff();
      allow create: if isValidId(tableId) &&
        isSignedIn() &&
        isValidTableSession(incoming()) &&
        (isStaff() || incoming().customerUid == request.auth.uid);
      allow update: if isValidId(tableId) &&
        isSignedIn() &&
        isValidTableSession(incoming()) &&
        (isStaff() || (existing().customerUid == request.auth.uid && incoming().customerUid == request.auth.uid));
      allow delete: if isValidId(tableId) && isStaff();
    }

    // 3E. Customer Contacts Directory (Staff read/write, Signed-in customer upsert own contact)
    match /customer_contacts/{phoneKey} {
      allow get: if isValidPhoneKey(phoneKey) && (
        isStaff() ||
        (isSignedIn() && existing().customerUid == request.auth.uid)
      );
      allow list: if isStaff();
      allow create: if isValidPhoneKey(phoneKey) &&
        isSignedIn() &&
        isValidCustomerContact(incoming()) &&
        incoming().phone == phoneKey &&
        incoming().createdAt == request.time &&
        (isStaff() || incoming().customerUid == request.auth.uid);
      allow update: if isValidPhoneKey(phoneKey) &&
        isSignedIn() &&
        isValidCustomerContact(incoming()) &&
        incoming().phone == existing().phone &&
        incoming().createdAt == existing().createdAt &&
        (isStaff() || (existing().customerUid == request.auth.uid && incoming().customerUid == request.auth.uid));
      allow delete: if isValidPhoneKey(phoneKey) && isAdmin();
    }

    // 4. Inventory (Admin write, Staff with reports_history or Admin read)
    match /inventory/{itemId} {
      allow get: if isValidId(itemId) && (isAdmin() || hasPerm('reports_history'));
      allow list: if isAdmin() || hasPerm('reports_history');
      allow create: if isValidId(itemId) && isAdmin() && isValidInventoryItem(incoming()) && incoming().id == itemId;
      allow update: if isValidId(itemId) && isAdmin() && isValidInventoryItem(incoming()) && incoming().id == existing().id;
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // 5. Staff Config (PIN verification read for signed-in app terminal, Admin write)
    match /config/staff {
      allow get: if isSignedIn();
      allow create, update: if isAdmin() && isValidStaffConfig(incoming());
    }

    // 6. Staff Directory & Permissions (Admin full access, signed-in terminal reads active staff for PIN login)
    match /staff/{staffId} {
      allow get: if isValidId(staffId) && (isAdmin() || (isSignedIn() && existing().active == true));
      allow list: if isAdmin() || (isSignedIn() && existing().active == true);
      allow create: if isValidId(staffId) &&
        isAdmin() &&
        isValidStaffMember(incoming()) &&
        incoming().id == staffId &&
        incoming().createdAt == request.time;
      allow update: if isValidId(staffId) &&
        isAdmin() &&
        isValidStaffMember(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(staffId) && isAdmin();
    }

    // 7. PIN-verified Staff Sessions (bound strictly to request.auth.uid and verified against config/staff or active staff doc)
    match /staff_sessions/{sessionUid} {
      allow get: if isValidId(sessionUid) && isSignedIn() && request.auth.uid == sessionUid;
      allow create, update: if isValidId(sessionUid) &&
        isSignedIn() &&
        request.auth.uid == sessionUid &&
        isValidStaffSession(incoming()) &&
        incoming().uid == request.auth.uid &&
        (
          (incoming().isAdmin == true && isValidAdminPin(incoming().pin)) ||
          (
            incoming().isAdmin == false &&
            exists(/databases/$(database)/documents/staff/$(incoming().staffId)) &&
            get(/databases/$(database)/documents/staff/$(incoming().staffId)).data.active == true &&
            get(/databases/$(database)/documents/staff/$(incoming().staffId)).data.pin == incoming().pin
          )
        );
      allow delete: if isValidId(sessionUid) && isSignedIn() && request.auth.uid == sessionUid;
    }

    // 8. Legacy collections retained closed to client writes
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /authorized_staff/{staffEmail} {
      allow get: if isValidEmailKey(staffEmail) && isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidAuthorizedStaff(incoming());
    }
  }
}
